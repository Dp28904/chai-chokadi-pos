generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money is stored in paise (Rs 49.50 = 4950).

enum Role {
  ADMIN
  COUNTER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum OfferType {
  PERCENT_OFF
  FLAT_OFF
  BUY_X_GET_Y
}

enum OfferScope {
  ITEM
  CATEGORY
  BILL
}

enum StockReason {
  RESTOCK
  SALE
  WASTAGE
  ADJUST
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(COUNTER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  orders       Order[]  @relation("OrderCreatedBy")
  servedOrders Order[]  @relation("OrderServedBy")
}

model Category {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)
  items     Item[]
}

model Item {
  id            Int          @id @default(autoincrement())
  categoryId    Int
  category      Category     @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  price         Int
  imageUrl      String?
  isActive      Boolean      @default(true)
  isFavourite   Boolean      @default(false) // shown in "Chokadi Favourites" on the counter home
  trackStock    Boolean      @default(false)
  qtyOnHand     Int          @default(0)
  lowStockAt    Int          @default(0)
  comboItems    ComboItem[]
  orderLines    OrderLine[]
  stockMoves    StockMovement[]
}

model Combo {
  id               Int         @id @default(autoincrement())
  name             String
  description      String?
  imageUrl         String?
  price            Int
  isActive         Boolean     @default(true)
  // "Choice" combo: customer picks choiceQty items from this category.
  choiceCategoryId Int?
  choiceQty        Int?
  items      ComboItem[]
  orderLines OrderLine[]
}

model ComboItem {
  comboId Int
  itemId  Int
  qty     Int   @default(1)
  combo   Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  item    Item  @relation(fields: [itemId], references: [id])

  @@id([comboId, itemId])
}

model Offer {
  id             Int          @id @default(autoincrement())
  name           String
  type           OfferType
  scope          OfferScope
  targetId       Int?         // item or category id, depending on scope
  value          Int          @default(0) // percent, or paise for FLAT_OFF
  minBillAmount  Int          @default(0)
  minQty         Int          @default(0) // units of matching items needed (ITEM/CATEGORY)
  maxDiscount    Int?         // cap in paise ("upto Rs 5")
  buyQty         Int?
  getQty         Int?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)
  orderOffers    OrderOffer[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id            Int            @id @default(autoincrement())
  billNo        Int            @unique @default(autoincrement())
  // Generated by the device per checkout; a retried request returns the same bill.
  clientRef     String?        @unique
  customerId    Int
  customer      Customer       @relation(fields: [customerId], references: [id])
  createdById   Int
  createdBy     User           @relation("OrderCreatedBy", fields: [createdById], references: [id])
  subtotal      Int
  discountTotal Int            @default(0)
  grandTotal    Int
  status        OrderStatus    @default(PENDING)
  paymentMethod PaymentMethod?
  businessDate  DateTime       @db.Date
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  // Ticked in Bills once the food is handed over; independent of payment.
  servedAt      DateTime?
  servedById    Int?
  servedBy      User?          @relation("OrderServedBy", fields: [servedById], references: [id])
  lines         OrderLine[]
  offers        OrderOffer[]

  @@index([businessDate])
  @@index([status])
}

model OrderLine {
  id            Int     @id @default(autoincrement())
  orderId       Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        Int?
  item          Item?   @relation(fields: [itemId], references: [id])
  comboId       Int?
  combo         Combo?  @relation(fields: [comboId], references: [id])
  nameSnapshot  String
  choiceItemIds Int[]   @default([]) // items picked for a choice combo, per unit
  unitPrice     Int
  qty           Int
  lineDiscount  Int     @default(0)
  lineTotal     Int
}

model OrderOffer {
  id             Int    @id @default(autoincrement())
  orderId        Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offerId        Int
  offer          Offer  @relation(fields: [offerId], references: [id])
  discountAmount Int
}

model StockMovement {
  id        Int         @id @default(autoincrement())
  itemId    Int
  item      Item        @relation(fields: [itemId], references: [id])
  change    Int
  reason    StockReason
  orderId   Int?
  createdAt DateTime    @default(now())
}

model Setting {
  key   String @id
  value String
}

// Uploaded images (menu photos, payment QR) live in the DB because free
// hosts have ephemeral disks.
model Upload {
  id        Int      @id @default(autoincrement())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}
