# Postgres connection. On Neon use the DIRECT (not "pooled") connection string,
# keep ?sslmode=require and add &connect_timeout=15 (Neon may be waking up).
DATABASE_URL="postgresql://stall:stall@localhost:5432/stall?schema=public"

# Random, at least 32 characters. Generate with:  openssl rand -hex 32
JWT_SECRET=""

PORT=3000

# Used only on first boot, when the database has no users yet, to create the admin.
# In production the password must be 8+ characters and not "admin123".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Only needed if the frontend is hosted on a different domain (comma-separated).
# CORS_ORIGIN=https://your-frontend.example.com

# NODE_ENV=production
